NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_ALLOWED_EMAILS=toy.theeranan@gmail.com,toy.theeranan@icloud.com

# Server-only secret used to HMAC-sign the fp_storage_key cookie
# (src/lib/server-auth.ts) so it can't be forged by guessing/brute-forcing a
# storage_key. Falls back to SUPABASE_SERVICE_ROLE_KEY if unset, but set a
# dedicated value in production so rotating one doesn't rotate the other.
# Generate with: openssl rand -hex 32
# COOKIE_SIGNING_SECRET=

# ─── AI-powered analysis ──────────────────────────────────────────────────
# Default provider is your LOCAL Ollama running Gemma 4 on your Mac.
# Claude is used only as an automatic fallback when Ollama is unreachable.
#
#   1. Install Ollama:  https://ollama.com/download
#   2. Pull the model:  ollama pull gemma4
#   3. Make sure `ollama serve` is running (the Mac app starts it for you).
#
AI_PROVIDER=ollama                       # "ollama" (default) or "claude"
OLLAMA_BASE_URL=http://localhost:11434   # where your local Ollama listens
OLLAMA_MODEL=gemma4                       # e.g. gemma4, gemma4:e4b, gemma4:12b
#
# Optional Claude fallback — used only if Ollama can't be reached.
# ANTHROPIC_API_KEY=sk-ant-...
#
# REQUIRED for the on-demand AI Investment Recommendation
# (/api/investments/recommendation). That route calls the Anthropic API
# directly and uses Claude's server-side web_search tool (capped), which Ollama
# cannot do — so it needs ANTHROPIC_API_KEY regardless of AI_PROVIDER.
# Set it in Vercel → Project → Settings → Environment Variables for production.

# Google Drive backup (optional)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR-SECRET-KEY (server-side only, never expose to browser)
# NEXT_PUBLIC_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/auth/google-drive
# NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_ID=YOUR-FOLDER-ID

# LINE Login (required for "Sync from LINE" / LINE sign-in)
# Get these from the LINE Developers Console for your LINE Login channel.
# NEXT_PUBLIC_LINE_CLIENT_ID is the same value as LINE_CLIENT_ID, just exposed
# to the browser to build the OAuth authorize URL. LINE_CLIENT_ID and
# LINE_CLIENT_SECRET are server-only and used by /api/auth/line to exchange
# the auth code for a token — missing either causes "auth_failed" errors.
NEXT_PUBLIC_LINE_CLIENT_ID=YOUR-LINE-CHANNEL-ID
LINE_CLIENT_ID=YOUR-LINE-CHANNEL-ID
LINE_CLIENT_SECRET=YOUR-LINE-CHANNEL-SECRET (server-side only, never expose to browser)

# LINE Messaging API (required for watchlist price alerts + LINE pushes)
# LINE Notify was discontinued 2025-03-31 — pushes now use the Messaging API.
# In the LINE Developers Console (same provider as your Login channel):
#   1. Create a "Messaging API" channel
#   2. Messaging API tab → issue a long-lived Channel access token → paste below
#   3. Add the bot as a friend (QR code on the same tab) with your LINE account
LINE_CHANNEL_ACCESS_TOKEN=YOUR-MESSAGING-API-CHANNEL-ACCESS-TOKEN

# Vercel Cron auth for /api/cron/watchlist-alerts (see vercel.json)
CRON_SECRET=YOUR-RANDOM-64-CHAR-SECRET
